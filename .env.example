DATABASE_URL=postgresql://peclat:peclat_local@localhost:5432/peclat
APP_URL=http://localhost:3000
# Use local no desenvolvimento e supabase na hospedagem.
DOCUMENT_STORAGE_PROVIDER=local
# Usado somente pelo provedor local. O padrão é .local/documents.
DOCUMENT_STORAGE_DIR=.local/documents
# Credenciais exclusivas do backend para o Supabase Storage. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternativa legada à chave secreta acima. Configure somente uma delas e mantenha no servidor.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=peclat-crm-documents
SEED_ADMIN_EMAIL=admin@peclat.local
SEED_ADMIN_NAME=Administrador Peclat
# Defina uma senha exclusiva com pelo menos 12 caracteres antes do seed.
SEED_ADMIN_PASSWORD=
# Usado na recuperação de senha e no envio de orçamentos PDF.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Peclat Solar <crm@peclat.local>
# Reservadas para FASE 7. Não configuram uma integração nesta fase.
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
GRAPH_API_VERSION=
