{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peclat-solar-crm",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_URL": "https://app.peclatsolar.com"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "727f5f1a02fb48f08a1c8f1346ff84f2"
    }
  ],
  "observability": {
    "enabled": true
  }
}
