{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "peclat-solar-crm",
  "main": "worker.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_URL": "https://peclat-solar-crm.peclatsolar.workers.dev",
    "DOCUMENT_STORAGE_PROVIDER": "supabase",
    "SUPABASE_URL": "https://jawnlkqhdywcsfmcjezk.supabase.co",
    "SUPABASE_STORAGE_BUCKET": "peclat-crm-documents"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "727f5f1a02fb48f08a1c8f1346ff84f2"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}
